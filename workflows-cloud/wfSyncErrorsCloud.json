{
  "id": "wfSyncErrorsCloud",
  "name": "Feed sync (Cloud): error handler",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "note-about",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -100
      ],
      "parameters": {
        "content": "## Error handler (n8n Cloud)\nIf the feed sync itself fails (for example Airtable can't be read or written), Slack gets the node name and message, and the run stops before anything is guessed.\n\nFill in **Settings**, then pick this workflow as the Error Workflow in the feed sync's settings.",
        "width": 900,
        "height": 180,
        "color": 1
      }
    },
    {
      "id": "error-trigger",
      "name": "Error trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "settings",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "settings-slackwebhookurl",
              "name": "slackWebhookUrl",
              "value": "https://hooks.slack.com/services/XXX",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "format-alert",
      "name": "Format alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "const e = $('Error trigger').first().json;\nconst node = (e.execution && e.execution.lastNodeExecuted) || 'unknown node';\nconst message = String((e.execution && e.execution.error && e.execution.error.message) || 'no message').replace(/pat[A-Za-z0-9.]{20,}/g, '***').slice(0, 300);\nreturn [{ json: { text: ':rotating_light: Feed sync stopped at \"' + node + '\": ' + message + '. No further sources were processed in this run.' } }];"
      }
    },
    {
      "id": "send-alert",
      "name": "Send alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.slackWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Error trigger": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Format alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format alert": {
      "main": [
        [
          {
            "node": "Send alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "versionId": "1"
}
